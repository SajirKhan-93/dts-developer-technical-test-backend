{
  "name": "hmcts-dev-test-backend-own",
  "version": "0.0.0",
  "description": "RESTful API for HMCTS caseworker task management (HapiJS, Prisma, PostgreSQL).",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "npm run db:migrate",
    "dev": "cross-env NODE_ENV=development node --watch --env-file-if-exists=.env ./src",
    "prestart": "npm run db:migrate",
    "start": "cross-env NODE_ENV=production node --use-strict --env-file-if-exists=.env .",
    "db:migrate": "node --env-file-if-exists=.env src/plugins/database/helpers/migrate.js",
    "format": "prettier --write \"**/*.{cjs,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{cjs,js,json,md}\"",
    "lint": "eslint --cache --cache-strategy content \"**/*.{cjs,js}\"",
    "lint:fix": "npm run lint -- --fix",
    "postinstall": "npm run prisma:generate",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "test": "cross-env NODE_ENV=test TZ=UTC vitest run --coverage",
    "test:watch": "cross-env NODE_ENV=test TZ=UTC vitest"
  },
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@hapi/hapi": "21.4.10",
    "@hapi/inert": "7.1.2",
    "@hapi/vision": "7.0.3",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "convict": "6.2.5",
    "convict-format-with-validator": "6.2.0",
    "hapi-pino": "13.0.0",
    "hapi-swagger": "17.3.2",
    "joi": "18.2.3",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "prisma": "7.9.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.10",
    "cross-env": "10.1.0",
    "eslint": "9.39.4",
    "neostandard": "0.13.0",
    "prettier": "3.9.6",
    "vitest": "4.1.10"
  },
  "overrides": {
    "hapi-swagger": {
      "joi": "$joi"
    },
    "hapi-pino": {
      "pino": "$pino"
    },
    "joi": "$joi"
  }
}
